{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 tools/build_vercel.py",
  "outputDirectory": "public",
  "public": false,
  "regions": ["icn1"],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "includeFiles": "web/menus.json",
      "excludeFiles": "{public/**,web/assets/**,web/*.js,web/*.css,web/*.html,web/*.md,tests/**,tools/**,docs/**,data/**,venv/**,server/database.py,server/main.py,server/models.py,server/predict.py,**/*.db,**/*.csv}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
